# ChisaBot 好友可装包 · 安全默认（Track D / PRD-P2-04）
# 复制为 deploy/.env 后由 friend-up.sh 填密钥；不要把填好的 .env 提交进 Git。

OPENBOT_RUNTIME_MODE=local
SL_ENABLED=false
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
OPENBOT_SELF_HOST_BANNER=false

# 单用户仅允许配合 loopback TRUSTED_ORIGINS（公网必须走 HTTPS 登录网关，禁止把 :3001 直接暴露）。
OPENBOT_SINGLE_USER=true
TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# 加密库内模型密钥；friend-up.sh 会在空时生成。必须与数据库备份一起保存。
KEY_ENCRYPTION_KEY=

CHISABOT_IMAGE=local/chisabot:latest
CHISABOT_SOURCE_DIR=
MAGPIE_NETWORK=openbot_magpie
# 管理后台 → 模型平台 Magpie（docs/magpie.md）：三项都填才内嵌 Magpie 控制台；key 文件挂载由 compose 读这里，不用改 compose.yaml。
# MAGPIE_ADMIN_URL=http://magpie:3430
# MAGPIE_WEB_KEY_FILE=/etc/chisabot/magpie-web.key
# MAGPIE_WEB_KEY_HOST_FILE=./secrets/magpie-web.key
DEPLOYMENT_ID=openbot-zh

# 机器人电脑的完整 sudo：off（默认）/ full（容器内 root，能读到加密密钥和数据库；风险见 docs/computer-sudo.md）
# CHISABOT_COMPUTER_SUDO=off

BOT_PROVIDER=openai
BOT_MODEL=your-model-id
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 公网入口（填域名后必须配 HTTPS 网关；应用端口仍只绑 127.0.0.1）
CHISABOT_DOMAIN=
CHISABOT_HTTPS_PORT=8443
CHISABOT_MAGPIE_PORT=2053
CHISABOT_CERT_DIRECTORY=/etc/letsencrypt
CHISABOT_CERT_NAME=
CHISABOT_NGINX_CONF=./nginx.conf

# 分享给朋友（多账号）时：应用与登录网关共用同一密钥（≥32 字符）。friend-up.sh 可生成。
# CHISABOT_GATEWAY_SECRET=
# CHISABOT_ACCOUNTS_UI=1

# 可选：强制 Better Auth Secure cookie（https 公网 URL 时也会自动开）
# CHISABOT_SECURE_COOKIES=1

# 禁止把本机内网放给机器人浏览器（生产默认不要开）
# AGENT_COMPUTER_ALLOW_PRIVATE_HOSTS=true
