+      - name: Require installable Android release
+        env:
+          VERSION: ${{ needs.config.outputs.version }}
+          VERSION_CODE: ${{ needs.config.outputs.version_code }}
+        run: |
+          apk="release-assets/ChisaBot-Android-$VERSION.apk"
+          if [ ! -f "$apk" ]; then
+            echo "::error::没有已签名 APK，拒绝发布不可安装的安卓包。配置 ANDROID_KEYSTORE_* Secrets 或提供离线签名 APK。"
